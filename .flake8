[flake8]
max-line-length = 120
ignore =
    E501,
    W293,
    W391,
    W503,
    W504,
    E221,
    E241,
    E231,
    E251,
    E261,
    E272,
    E302,
    E303,
    E305,
    E401,
    E402,
    E701,
    E722,
    E226,
    E127,
    E128,
    F401,
    F541,
    F811
exclude =
    .git,
    __pycache__,
    server/venv,
    venv,
    .venv,
    node_modules,
    client/node_modules,
    *.egg-info,
    build,
    dist
